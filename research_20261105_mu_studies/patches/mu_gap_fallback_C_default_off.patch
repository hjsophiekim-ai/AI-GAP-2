+# ── MU 예정 공백 (2026-11-04) ─────────────────────────────────────────────
+GAP_SCHEDULED = "SCHEDULED_GAP"
+GAP_OUTSIDE_WINDOW = "OUTSIDE_WINDOW"
+GAP_MU_PRESENT = "MU_DATA_IN_WINDOW"
+GAP_NO_MU = "MU_NO_DATA"
+GAP_DNAS_ENDED_EARLY = "DNAS_ENDED_EARLY"
+
+
+def _gap_window_end(n: datetime) -> datetime:
+    """예정 공백 끝 = 그날 주간거래(RBAQMU) 시작. 서머타임이면 09:00 이라 공백이 없다."""
+    return daytime_open_kst(n)
+
+
+def scheduled_gap(now: datetime, series: Optional[pd.Series] = None, data_dir: Optional[str] = None) -> tuple[bool, str]:
+    """지금의 MU 판정불가가 'DNASMU 종료 ~ RBAQMU 시작' 예정 공백 때문인지.
+
+    True 조건: KST [MU_GAP_FALLBACK_START, 주간거래 시작) ∧ 그 구간에 MU 실분봉이 이어지지 않음(시작 직후 2분 안 잔여 체결만 허용) ∧
+    DNASMU 실분봉이 (시작 - MU_GAP_FALLBACK_DNAS_TAIL_MIN분) 이후까지 있었음. 월요일은 미국 일요일 저녁이라
+    DNASMU 가 원래 없으므로 MU 데이터가 아예 없어도 예정 공백으로 본다(로거 생존은 체결강도 스냅샷이 따로 확인)."""
+    n = _naive(now)
+    start = datetime.combine(n.date(), config.MU_GAP_FALLBACK_START)
+    end = _gap_window_end(n)
+    if not (start <= n < end):
+        return False, GAP_OUTSIDE_WINDOW
+    s = series if series is not None else load_mu_1m(now, data_dir)
+    if s is not None and not s.empty:
+        s = _upto(s, n)                    # 판정 시각까지 완성된 분봉만 (재생 파일엔 그 뒤 분도 있다)
+    if s is None or s.empty:
+        return (True, GAP_SCHEDULED) if n.weekday() == 0 else (False, GAP_NO_MU)
+    last = s.index.max()
+    # DNASMU 는 끊기는 순간(09:00:00)에도 체결 1건을 보낸다(2026-11-04 raw frames) -> 09:00 분봉 1개는 공백으로 본다.
+    if last >= start + timedelta(minutes=2):
+        return False, GAP_MU_PRESENT
+    if last < start - timedelta(minutes=int(config.MU_GAP_FALLBACK_DNAS_TAIL_MIN)):
+        return False, GAP_DNAS_ENDED_EARLY
+    return True, GAP_SCHEDULED
+
+
+def gap_ledger_fields(trace: Optional[dict]) -> dict[str, Any]:
+    """신호원장 additive 컬럼. trace 가 없으면 빈 dict(행 모양 불변)."""
+    if not trace:
+        return {}
+    return {
+        "mu_gap_fallback": bool(trace.get("decision") == WAIT_SELECTIVE_APPROVED),
+        "mu_gap_reason": str(trace.get("reason") or ""),
+        "mu_gap_exec_strength": "" if trace.get("cttr") is None else round(float(trace["cttr"]), 3),
+        "mu_gap_exec_strength_state": str(trace.get("cttr_state") or ""),
+        "mu_gap_opposite_gap": "" if trace.get("opposite_gap") is None else round(float(trace["opposite_gap"]), 4),
+        "mu_gap_decision": str(trace.get("decision") or ""),
+    }
+
+
