+def _hy_gap_prev_from_bars(bars_3m, flag_bar_dt: datetime, direction: Direction) -> Optional[float]:
+    """방향부호 × 플래그 직전 완성 3분봉의 하이닉스 MACD diff — T+2 기록의 hy_gap_prev 와 같은 정의.
+    MU 예정 공백 대체확인(2026-11-04)에서 T+2 기록이 없을 때만 쓴다. 계산 불가면 None."""
+    try:
+        ms = calculate_macd_series(bars_3m)
+        if ms is None or ms.empty:
+            return None
+        idx = ms.index[pd.to_datetime(ms["datetime"]) == pd.Timestamp(flag_bar_dt)]
+        if len(idx) == 0 or idx[0] == 0:
+            return None
+        i = int(idx[0]) - 1
+        diff = float(ms["macd"].iloc[i] - ms["signal"].iloc[i])
+    except Exception:  # noqa: BLE001 — 계산 실패는 '판정 불가'(= 차단)로 끝난다
+        return None
+    return diff if direction == Direction.UP_RED else -diff
