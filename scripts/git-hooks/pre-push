#!/usr/bin/env bash
# main-MACD2 장중 push 차단 (2026-11-16).
#
# 2026-11-13 09:19 장중 push -> Render 자동배포 -> 프로세스 교체 동안 신호 공백.
# 평일 08:00~15:40 KST 에 origin 의 main-MACD2 로 가는 push 를 막는다.
#
# 설치(이 저장소에서 한 번):  git config core.hooksPath scripts/git-hooks
# 긴급 hotfix 로 꼭 장중에 올려야 하면:  MACD2_ALLOW_INTRADAY_DEPLOY=1 git push ...
#   (그 경우 push 직후 UI 또는 supervisor 원장으로 worker 재기동을 확인할 것)
set -u
PROTECTED_REF="refs/heads/main-MACD2"

if [ "${MACD2_ALLOW_INTRADAY_DEPLOY:-0}" = "1" ]; then
  exit 0
fi

# KST = UTC+9 (DST 없음). GNU date(Git Bash 포함) 기준.
kst=$(date -u -d '+9 hours' '+%u %H %M' 2>/dev/null) || exit 0
set -- $kst
dow=$1; hh=$((10#$2)); mm=$((10#$3))
mins=$((hh * 60 + mm))
in_window=0
if [ "$dow" -le 5 ] && [ "$mins" -ge $((8 * 60)) ] && [ "$mins" -lt $((15 * 60 + 40)) ]; then
  in_window=1
fi
[ "$in_window" = 1 ] || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$PROTECTED_REF" ]; then
    printf '%s\n' \
      "[pre-push] 차단: 평일 08:00~15:40 KST 에는 main-MACD2 push 금지 (Render 자동배포 = 장중 worker 교체)." \
      "           feature 브랜치 push 는 허용됩니다. 장 마감(15:40) 이후 다시 push 하세요." \
      "           긴급 hotfix: MACD2_ALLOW_INTRADAY_DEPLOY=1 git push ...  (직후 worker 재기동 확인 필수)" >&2
    exit 1
  fi
done
exit 0
